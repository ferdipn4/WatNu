NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Used first when set. Falls back to XAI_API_KEY otherwise.
ANTHROPIC_API_KEY=
XAI_API_KEY=

# Optional model overrides. Anthropic uses Sonnet when ANTHROPIC_API_KEY is set.
ANTHROPIC_MODEL=claude-sonnet-4-5
# XAI_MODEL=grok-2-vision-1212

# Link previews: the absolute origin (optional on Vercel, where the production domain is used).
# NEXT_PUBLIC_SITE_URL=https://watnu.app

# Shown on /about ("Questions, or want something removed? Write to …"); the line is left out when unset.
NEXT_PUBLIC_CONTACT_EMAIL=

# Push reminders. Make the VAPID pair once with `npx web-push generate-vapid-keys`; the public key
# is used by the phones, the private one by the sender. VAPID_SUBJECT is a mailto: or https: URL
# push services may contact. CRON_SECRET is what Vercel's cron sends to /api/push/run — the same
# value must be stored as app_config.push_cron_secret (see supabase/schema.sql).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@example.com
CRON_SECRET=
